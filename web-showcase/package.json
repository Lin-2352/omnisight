{
  "name": "omnisight-web-showcase",
  "version": "2.1.0",
  "private": true,
  "description": "OmniSight web showcase and zero-downtime playground (Next.js, Vercel/Netlify).",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/gen-types.mjs --check",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/test_api_failover.ts",
    "ci": "npm run check:types && npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}

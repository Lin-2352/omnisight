# =============================================================================
# OmniSight environment template
# Values below are non-secret placeholders or safe defaults. Real values never
# get committed (every .env* file except this one is git-ignored).
#
# Where each block is actually loaded from (there is no single shared .env):
#   [kaggle-server]  Kaggle Add-ons -> Secrets, falling back to process
#                    environment variables when run outside Kaggle.
#   [desktop-client] A `.env` file at the repository root, parsed by the
#                    client's own loader (no python-dotenv dependency); real
#                    environment variables take precedence over the file.
#   [web-showcase]   `web-showcase/.env.local` for `next dev`, and the Vercel /
#                    Netlify project settings in production. Next.js only
#                    reads env files from its own project directory.
# =============================================================================

# -----------------------------------------------------------------------------
# [kaggle-server] Inference node + tunnel publisher
# On Kaggle, do NOT upload a .env file: add these under
#   Notebook -> Add-ons -> Secrets
# and they are read via kaggle_secrets.UserSecretsClient().
# -----------------------------------------------------------------------------

# ID of the public GitHub Gist that stores the live tunnel URL.
# It is the 32-char hex segment of https://gist.github.com/<owner>/<GIST_ID>
OMNISIGHT_GIST_ID=

# Fine-grained or classic GitHub Personal Access Token with ONLY the `gist`
# scope. Used exclusively by the Kaggle node to PATCH the gist.
# Never give this token to the desktop client or the web app.
GITHUB_TOKEN=

# File inside the gist that holds the EndpointRecord JSON document.
OMNISIGHT_GIST_FILENAME=omnisight-endpoint.json

# Hugging Face model repository served by the inference node.
OMNISIGHT_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct

# Local port uvicorn binds to; cloudflared forwards to 127.0.0.1:<port>.
OMNISIGHT_PORT=8000

# Optional shared bearer token. When set, /v1/analyze requires
# `Authorization: Bearer <token>`. Keep empty to disable. This value is never
# written to the gist.
OMNISIGHT_API_KEY=

# Optional Hugging Face token (only needed for gated models or higher rate limits).
HF_TOKEN=

# Seconds between gist heartbeat updates.
OMNISIGHT_HEARTBEAT_INTERVAL_S=60

# Speech-to-text model for voice queries. Preloaded at startup by default (~155 MB VRAM,
# not counted in the model baseline) so the first voice request is not ~7 s slower.
OMNISIGHT_ASR_MODEL_ID=openai/whisper-base
OMNISIGHT_ASR_PRELOAD=1

# Comma-separated browser origins allowed by CORS ("*" = any). No credentials are
# ever allowed. Setting OMNISIGHT_API_KEY means browsers must go through a
# server-side proxy route, because a key in browser code is public.
OMNISIGHT_CORS_ORIGINS=*

# Concurrent analyze requests admitted (running + waiting). More returns HTTP 429.
OMNISIGHT_MAX_QUEUE=4
# Seconds a request may wait for the GPU before HTTP 504.
OMNISIGHT_QUEUE_TIMEOUT_S=120
# Wall-clock cap on one generation (finish_reason becomes "timeout").
OMNISIGHT_GENERATION_TIMEOUT_S=90

# VRAM guardrails in decimal GB (10^9 bytes), measured with torch.cuda.memory_allocated.
# Allocations beyond the ceiling raise CUDA OOM, answered with HTTP 507.
OMNISIGHT_VRAM_CEILING_GB=11.0
OMNISIGHT_BASELINE_BUDGET_GB=5.8

# Quantize lm_head to NF4 as well (~0.8 GB less VRAM, some output-quality cost).
# Leave 0 unless the measured baseline exceeds the budget and you accept the trade-off.
OMNISIGHT_QUANTIZE_LM_HEAD=0

# Quantize the vision tower to NF4 (default 1). 0 keeps it in fp16: about +1 GB
# baseline VRAM for ~5% faster generation; OCR accuracy measured equal on Kaggle T4.
OMNISIGHT_QUANTIZE_VISION=1

# Qwen2-VL image processor pixel bounds (256x256 .. 1280x720).
OMNISIGHT_MIN_PIXELS=65536
OMNISIGHT_MAX_PIXELS=921600
OMNISIGHT_REPETITION_PENALTY=1.1

# Anti-idle loop interval in seconds.
OMNISIGHT_KEEPALIVE_INTERVAL_S=180

# cloudflared transport: http2 (default, avoids QUIC fallback delays), quic, or auto.
OMNISIGHT_TUNNEL_PROTOCOL=http2
# Seconds to wait for a registered tunnel before restarting cloudflared.
OMNISIGHT_TUNNEL_START_TIMEOUT_S=45
# Optional path to a cloudflared binary (default: downloaded by pycloudflared).
OMNISIGHT_CLOUDFLARED_BIN=

# DEBUG, INFO, WARNING or ERROR.
OMNISIGHT_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# [desktop-client] Windows HUD
# The client only reads the public gist, so it needs no GitHub token.
# -----------------------------------------------------------------------------

# Same gist ID as above; the client resolves the live URL from it.
# (OMNISIGHT_GIST_ID is shared with the kaggle-server block.)

# GitHub username that owns the gist (used to build the raw URL).
OMNISIGHT_GIST_OWNER=

# Bypass gist discovery and talk to a fixed endpoint (e.g. http://127.0.0.1:8000
# while developing the server locally). Leave empty for normal operation.
OMNISIGHT_ENDPOINT_OVERRIDE=

# Seconds the resolved endpoint URL is cached before re-reading the gist.
OMNISIGHT_ENDPOINT_CACHE_TTL_S=30

# Per-request timeout for /v1/analyze in seconds (cold 7B generation is slow).
OMNISIGHT_REQUEST_TIMEOUT_S=90

# -----------------------------------------------------------------------------
# [web-showcase] Next.js (Vercel / Netlify)
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server. Never add the
# prefix to a secret: it would be inlined into the browser bundle.
# -----------------------------------------------------------------------------

# Server-only: Google AI Studio key for /api/fallback-infer. Optional; when it
# is empty the fallback route uses deterministic evaluation instead.
GEMINI_API_KEY=

# Server-only: fallback model name. Kept configurable because hosted model IDs
# are retired over time.
FALLBACK_MODEL=gemini-2.5-flash

# Server-only: timeout for the fallback model call in milliseconds.
FALLBACK_TIMEOUT_MS=25000

# Public: raw URL of the gist file, used by the browser's live-status indicator.
# Format: https://gist.githubusercontent.com/<owner>/<gist_id>/raw/omnisight-endpoint.json
NEXT_PUBLIC_GIST_RAW_URL=

# Public: download link for the Windows installer release asset.
NEXT_PUBLIC_RELEASE_URL=https://github.com/<owner>/omnisight/releases/latest/download/OmniSight-Setup.exe

# Public: canonical GitHub repository URL shown in the site header/footer.
NEXT_PUBLIC_REPO_URL=https://github.com/<owner>/omnisight

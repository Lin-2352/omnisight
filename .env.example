# =============================================================================
# OmniSight environment template
# Values below are non-secret placeholders or safe defaults. Real values never
# get committed (every .env* file except this one is git-ignored).
#
# Where each block is actually loaded from (there is no single shared .env):
#   [kaggle-server]  Kaggle Add-ons -> Secrets, falling back to process
#                    environment variables when run outside Kaggle.
#   [desktop-client] %APPDATA%/OmniSight/.env, then `.env` at the repository
#                    root (loaded with python-dotenv); real environment
#                    variables take precedence over both files.
#   [web-showcase]   `web-showcase/.env.local` for `next dev`, and the Vercel /
#                    Netlify project settings in production. Next.js only
#                    reads env files from its own project directory.
# =============================================================================

# -----------------------------------------------------------------------------
# [kaggle-server] Inference node + tunnel publisher
# On Kaggle, do NOT upload a .env file: add these under
#   Notebook -> Add-ons -> Secrets
# and they are read via kaggle_secrets.UserSecretsClient().
# -----------------------------------------------------------------------------

# ID of the public GitHub Gist that stores the live tunnel URL.
# It is the 32-char hex segment of https://gist.github.com/<owner>/<GIST_ID>
OMNISIGHT_GIST_ID=

# Fine-grained or classic GitHub Personal Access Token with ONLY the `gist`
# scope. Used exclusively by the Kaggle node to PATCH the gist.
# Never give this token to the desktop client or the web app.
GITHUB_TOKEN=

# File inside the gist that holds the EndpointRecord JSON document.
OMNISIGHT_GIST_FILENAME=omnisight-endpoint.json

# Hugging Face model repository served by the inference node.
OMNISIGHT_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct

# Local port uvicorn binds to; cloudflared forwards to 127.0.0.1:<port>.
OMNISIGHT_PORT=8000

# Optional shared bearer token. When set, /v1/analyze requires
# `Authorization: Bearer <token>`. Keep empty to disable. This value is never
# written to the gist.
OMNISIGHT_API_KEY=

# Optional Hugging Face token (only needed for gated models or higher rate limits).
HF_TOKEN=

# Seconds between gist heartbeat updates.
OMNISIGHT_HEARTBEAT_INTERVAL_S=60

# Speech-to-text model for voice queries. Preloaded at startup by default (~155 MB VRAM,
# not counted in the model baseline) so the first voice request is not ~7 s slower.
OMNISIGHT_ASR_MODEL_ID=openai/whisper-base
OMNISIGHT_ASR_PRELOAD=1

# Comma-separated browser origins allowed by CORS ("*" = any). No credentials are
# ever allowed. Setting OMNISIGHT_API_KEY means browsers must go through a
# server-side proxy route, because a key in browser code is public.
OMNISIGHT_CORS_ORIGINS=*

# Concurrent analyze requests admitted (running + waiting). More returns HTTP 429.
OMNISIGHT_MAX_QUEUE=4
# Seconds a request may wait for the GPU before HTTP 504.
OMNISIGHT_QUEUE_TIMEOUT_S=120
# Wall-clock cap on one generation (finish_reason becomes "timeout").
OMNISIGHT_GENERATION_TIMEOUT_S=90

# VRAM guardrails in decimal GB (10^9 bytes), measured with torch.cuda.memory_allocated.
# Allocations beyond the ceiling raise CUDA OOM, answered with HTTP 507.
OMNISIGHT_VRAM_CEILING_GB=11.0
OMNISIGHT_BASELINE_BUDGET_GB=5.8

# Quantize lm_head to NF4 as well (~0.8 GB less VRAM, some output-quality cost).
# Leave 0 unless the measured baseline exceeds the budget and you accept the trade-off.
OMNISIGHT_QUANTIZE_LM_HEAD=0

# Quantize the vision tower to NF4 (default 1). 0 keeps it in fp16: about +1 GB
# baseline VRAM for ~5% faster generation; OCR accuracy measured equal on Kaggle T4.
OMNISIGHT_QUANTIZE_VISION=1

# Where the local node runs the model: auto (CUDA when available, else CPU), cuda or cpu.
# CPU mode needs no GPU but is slow (2B on an i9-13980HX: ~14 s to the first token, ~5 tok/s).
OMNISIGHT_DEVICE=auto
# CPU weights: float32 (best answers, ~10.5 GB RAM), int8 (~7.5 GB, weaker answers) or
# bfloat16 (only fast on CPUs with native bf16 math, e.g. AVX-512 BF16 / AMX).
OMNISIGHT_CPU_DTYPE=float32
# Torch CPU threads (empty = all physical cores).
OMNISIGHT_CPU_THREADS=
# Answers are capped on the CPU so they finish in a few minutes.
OMNISIGHT_CPU_MAX_NEW_TOKENS=256

# Qwen2-VL image processor pixel bounds (256x256 .. 1280x720).
OMNISIGHT_MIN_PIXELS=65536
OMNISIGHT_MAX_PIXELS=921600
OMNISIGHT_REPETITION_PENALTY=1.1

# Anti-idle loop interval in seconds.
OMNISIGHT_KEEPALIVE_INTERVAL_S=180

# cloudflared transport: http2 (default, avoids QUIC fallback delays), quic, or auto.
OMNISIGHT_TUNNEL_PROTOCOL=http2
# Seconds to wait for a registered tunnel before restarting cloudflared.
OMNISIGHT_TUNNEL_START_TIMEOUT_S=45
# Optional path to a cloudflared binary (default: downloaded by pycloudflared).
OMNISIGHT_CLOUDFLARED_BIN=

# DEBUG, INFO, WARNING or ERROR.
OMNISIGHT_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# [desktop-client] Windows HUD
# Everything here is optional: with no configuration the client discovers the
# node through the project's public gist and falls back to a local dev node.
# -----------------------------------------------------------------------------

# Gist holding omnisight-endpoint.json. Defaults to the project gist; falls
# back to OMNISIGHT_GIST_ID when unset.
GITHUB_GIST_ID=

# Optional token used only to READ the public gist, raising GitHub's API limit
# from 60 to 5000 requests/hour. Any token works, even one with no scopes. The
# client prefers OMNISIGHT_CLIENT_GITHUB_TOKEN so it never has to reuse the
# node's gist-write GITHUB_TOKEN from the block above.
OMNISIGHT_CLIENT_GITHUB_TOKEN=

# Last failover tier (backends auto and kaggle only): the web showcase's
# fallback route, same request and response contract. Unset = the public site
# https://omnisight-nine.vercel.app/api/fallback-infer, which forwards the
# screenshot to Gemini when the Kaggle GPU is asleep. Set to "off" to keep
# screenshots on Kaggle or your own GPU only.
FALLBACK_API_URL=

# Talk to a fixed node and skip gist discovery (e.g. http://127.0.0.1:8000
# while developing the server). Also accepted as OMNISIGHT_ENDPOINT_OVERRIDE.
MANUAL_OVERRIDE_URL=

# Second failover tier: a node running on this machine, on its GPU or its CPU
# (start it with scripts\run-local-gpu.ps1; -Device cpu when there is no NVIDIA GPU).
OMNISIGHT_LOCAL_DEV_URL=http://127.0.0.1:8000

# Which engine answers: auto (Kaggle, then this PC, then web fallback),
# kaggle (Kaggle, then web fallback) or local (this PC only). The tray's
# Backend menu and --backend override this and are remembered per user.
OMNISIGHT_BACKEND=auto

# Which device the app asks the local node to use when it starts it from the window:
# auto, cuda or cpu. The window's Engine picker overrides this and is remembered per user.
OMNISIGHT_LOCAL_DEVICE=auto

# Seconds the resolved endpoint is cached before the gist is read again.
OMNISIGHT_ENDPOINT_CACHE_TTL_S=30

# Connect and read timeouts for /v1/analyze. A 512-token answer takes ~40 s on
# a T4, so the read timeout must stay well above that.
OMNISIGHT_CONNECT_TIMEOUT_S=3
OMNISIGHT_REQUEST_TIMEOUT_S=60
# Read timeout for the local node: a CPU-only node can need minutes for a long answer.
OMNISIGHT_LOCAL_TIMEOUT_S=300
# Upper bound for one request across all retries and failover tiers.
OMNISIGHT_REQUEST_DEADLINE_S=120

# -----------------------------------------------------------------------------
# [web-showcase] Next.js (Vercel / Netlify)
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server. Never add the
# prefix to a secret: it would be inlined into the browser bundle.
# -----------------------------------------------------------------------------

# Server-only: Google AI Studio key for the Gemini tier of /api/fallback-infer.
# Optional: without it the route goes straight from the Kaggle node to the
# deterministic preset engine. Set it in the Vercel project settings, never in code.
GEMINI_API_KEY=

# Server-only: Gemini models tried in order. A 503 (overloaded) or 429 (free-tier
# per-model quota) on the first is retried once on the next. Kept configurable
# because hosted model IDs are retired over time.
FALLBACK_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite

# Server-only: gist holding omnisight-endpoint.json (defaults to the project gist).
# GITHUB_TOKEN here is an OPTIONAL read-only token (no scopes needed) that raises
# GitHub's API limit for gist reads; never reuse the node's gist-write token.
# GITHUB_GIST_ID=
# GITHUB_TOKEN=

# Public: canonical site URL (metadata / Open Graph) and repository link.
NEXT_PUBLIC_SITE_URL=https://<your-app>.vercel.app
NEXT_PUBLIC_REPO_URL=https://github.com/<owner>/omnisight

# Test hooks used only by web-showcase/tests/test_api_failover.ts. Leave unset
# in production: OMNISIGHT_GITHUB_API_BASE, GEMINI_API_BASE,
# OMNISIGHT_ALLOW_LOOPBACK_NODE.

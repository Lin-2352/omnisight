<ui:FluentWindow x:Class="OmniSight.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:OmniSight.Core.ViewModels;assembly=OmniSight.Core"
                 Title="OmniSight" Width="860" Height="760" MinWidth="560" MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 AutomationProperties.Name="OmniSight">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OmniSight" ShowMaximize="True" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:TextBlock Text="OmniSight" FontTypography="Title" />
                <ui:TextBlock Text="ask your screen" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ui:Card Grid.Row="1" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Connected}">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Failed}">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Disconnected}">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <ui:TextBlock Text="{Binding ConnectionText}" FontTypography="BodyStrong"
                                      AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <ui:TextBlock Text="{Binding StatusText}" Margin="20,8,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  AutomationProperties.LiveSetting="Polite" />
                    <ui:TextBlock Margin="20,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Run Text="Engine: " /><Run Text="{Binding EngineKey, Mode=OneWay}" />
                        <Run Text="   Node: " /><Run Text="{Binding NodeText, Mode=OneWay}" />
                    </ui:TextBlock>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Grid.Row="2" x:Name="Notice" Margin="0,0,0,12" IsClosable="False"
                        Title="" Message="{Binding NoticeText}" AutomationProperties.Name="Notice" />

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="Ping" Icon="{ui:SymbolIcon Pulse24}" Click="OnPing"
                               AutomationProperties.Name="Ping" Margin="0,0,8,0" />
                    <ui:Button x:Name="RetryButton" Content="Restart engine" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRetry"
                               AutomationProperties.Name="Restart engine" />
                </StackPanel>
                <ui:Card Grid.Row="1" Padding="0">
                    <ListBox x:Name="EventLog" ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Events" />
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>

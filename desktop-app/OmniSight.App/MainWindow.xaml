<ui:FluentWindow x:Class="OmniSight.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:OmniSight.Core.ViewModels;assembly=OmniSight.Core"
                 xmlns:md="clr-namespace:OmniSight.Core.Rendering;assembly=OmniSight.Core"
                 xmlns:v="clr-namespace:OmniSight.App.Views"
                 Title="OmniSight" Width="900" Height="820" MinWidth="560" MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 AutomationProperties.Name="OmniSight">
    <ui:FluentWindow.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <v:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
        <v:CountToVisibilityConverter x:Key="CountToVisibility" />
        <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One block of prose: heading, paragraph or list item, built from parsed runs (never markup) -->
        <DataTemplate DataType="{x:Type md:MarkdownBlock}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Marker" Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="Body" Grid.Column="1" TextWrapping="Wrap" v:RichText.Runs="{Binding Runs}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static md:BlockKind.Bullet}">
                    <Setter TargetName="Marker" Property="Text" Value="•" />
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static md:BlockKind.Numbered}">
                    <Setter TargetName="Marker" Property="Text" Value="{Binding Number, StringFormat={}{0}.}" />
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static md:BlockKind.Heading}">
                    <Setter TargetName="Body" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Body" Property="FontSize" Value="16" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProseBlock}">
            <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CodeCardBlock}">
            <Border CornerRadius="8" Margin="0,2,0,8" Padding="12,8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <ui:Button DockPanel.Dock="Right" Content="Copy" Padding="10,3" FontSize="12" Click="OnCopyBlock"
                                   AutomationProperties.Name="Copy code" ToolTip="Copy this code" />
                        <TextBlock Text="{Binding Language}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Code, Mode=OneWay}" FontFamily="{StaticResource CodeFont}"
                                 FontSize="13" TextWrapping="NoWrap" AutomationProperties.Name="Code" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One question and its answer -->
        <DataTemplate DataType="{x:Type vm:ExchangeCard}">
            <Border x:Name="Frame" CornerRadius="10" Padding="18,14" Margin="0,0,0,12" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Heading, Mode=OneWay}" FontSize="12"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="Question" />
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Summary, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                             Margin="0,8,0,10" AutomationProperties.Name="Summary" />
                    <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:Button Content="Copy Fix" Margin="0,0,8,0" Padding="16,6" MinWidth="96" Click="OnCopyFix" AutomationProperties.Name="Copy Fix"
                                   Visibility="{Binding HasCopyFix, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Copy Terminal Command" Padding="16,6" Click="OnCopyCommand" AutomationProperties.Name="Copy Terminal Command"
                                   Visibility="{Binding HasCopyCommand, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding RunButtons}" Margin="0,8,0,0" Focusable="False"
                                  Visibility="{Binding ShowRun, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Content="{Binding Label}" Margin="0,0,8,0" Click="OnRunClick"
                                           AutomationProperties.Name="{Binding AutomationName}"
                                           ToolTip="Review this command in a dialog and run it only after you type RUN" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SourcesTitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceLink}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Number, StringFormat=[{0}]}" FontSize="12" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                                   Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}">
                                            <Hyperlink Click="OnSourceClick" Tag="{Binding Url}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       ToolTip="{Binding Url}"><Run Text="{Binding Title, Mode=OneWay}" /></Hyperlink>
                                        </TextBlock>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Details}" FontSize="11" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWatch}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- links in answers must be readable on the card background -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="TipTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OmniSight" ShowMaximize="True" />

        <Grid Grid.Row="1" IsEnabled="{Binding NoRunApproval}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="24,4,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:TextBlock Text="OmniSight" FontTypography="Title" VerticalAlignment="Center" />
                    <ui:TextBlock Text="ask your screen" Margin="10,10,0,0" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <!-- wraps onto a second line instead of being clipped when the window is narrow -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="NodeButton" Content="{Binding NodeButtonText}" Margin="8,0,0,8" Click="OnNode"
                               Visibility="{Binding NodeVisible, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="Node" ToolTip="Start or stop the model running on this PC" />
                    <ComboBox x:Name="EngineBox" MinWidth="210" Margin="8,0,0,8" ItemsSource="{Binding Engines}"
                              DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedEngineKey, Mode=TwoWay}"
                              IsEnabled="{Binding CanInput}" AutomationProperties.Name="Engine" ToolTip="Where the answer is computed" />
                    <ui:Button Content="Clear" Icon="{ui:SymbolIcon Delete24}" Click="OnClear" IsEnabled="{Binding CanInput}" Margin="8,0,0,8"
                               AutomationProperties.Name="Clear" ToolTip="Clear the answers shown here" />
                    <ToggleButton Content="Options" IsChecked="{Binding IsPaneOpen, Mode=TwoWay}" Padding="14,6" Margin="8,0,0,8"
                                  AutomationProperties.Name="Options" ToolTip="Switches and settings" />
                </WrapPanel>
            </Grid>

            <!-- status pill -->
            <Border Grid.Row="1" CornerRadius="14" Padding="14,6" Margin="0,0,0,10" HorizontalAlignment="Left"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Connected}">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Failed}">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Disconnected}">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding StatusText, Converter={StaticResource NonEmptyToVisibility}}" />
                    <ui:ProgressRing Width="16" Height="16" Margin="12,0,0,0" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Stop voice" Icon="{ui:SymbolIcon Speaker024}" Margin="14,-4,-6,-4" Padding="10,3" Click="OnStopVoice"
                               AutomationProperties.Name="Stop voice" ToolTip="Stop reading the answer aloud (Esc does this too)"
                               Visibility="{Binding Speaking, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Restart engine" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="14,-4,-6,-4" Padding="10,3"
                               Click="OnRestart" AutomationProperties.Name="Restart engine"
                               Visibility="{Binding CanRestart, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <ui:InfoBar Grid.Row="2" x:Name="Notice" Margin="0,0,0,10" IsClosable="False" Title="" Message="{Binding NoticeText}"
                        AutomationProperties.Name="Notice" />

            <!-- conversation -->
            <ScrollViewer Grid.Row="3" x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid>
                    <StackPanel x:Name="EmptyState" Margin="0,20,0,0"
                                Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <ui:TextBlock Text="What would you like to know about your screen?" FontTypography="Subtitle" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <ui:Card Margin="0,0,0,10" Padding="16,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="Ask" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" AutomationProperties.Name="Tip: Ask" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Type a question below and press Enter. Turn off “Include my screen” to just chat." />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,10" Padding="16,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="Capture" Foreground="{DynamicResource SystemFillColorSuccessBrush}" AutomationProperties.Name="Tip: Capture" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Press Capture, or Alt+C anywhere, to have the screen explained." />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,10" Padding="16,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="Speak" Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.Name="Tip: Speak" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Hold Alt+V and ask out loud, or use the Speak button." />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                    <ItemsControl x:Name="Cards" ItemsSource="{Binding Conversation}" Focusable="False" Margin="0,0,6,0" />
                </Grid>
            </ScrollViewer>

            <!-- composer -->
            <Grid Grid.Row="4" Margin="0,12,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="AskBox" Grid.Column="0" Margin="0,0,8,0" MaxLength="4000" ClearButtonEnabled="False"
                            PlaceholderText="{Binding Placeholder}" Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanInput}" KeyDown="OnAskKeyDown" AutomationProperties.Name="Ask box" />
                <ui:Button Grid.Column="1" Content="Send" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Click="OnSend"
                           IsEnabled="{Binding CanInput}" AutomationProperties.Name="Send" ToolTip="Capture the screen and ask this question" />
            </Grid>
            <DockPanel Grid.Row="5">
                <ui:ToggleSwitch DockPanel.Dock="Right" Content="Include my screen" IsChecked="{Binding IncludeScreen, Mode=TwoWay}"
                                 IsEnabled="{Binding CanInput}" AutomationProperties.Name="Include screen"
                                 ToolTip="Off: just chat, nothing is captured and no image is sent" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Capture screen" Icon="{ui:SymbolIcon Camera24}" Click="OnCapture" IsEnabled="{Binding CanInput}"
                               Margin="0,0,8,0" AutomationProperties.Name="Capture" ToolTip="Explain what is on the screen (same as Alt+C)" />
                    <ui:Button Content="{Binding MicText}" Icon="{ui:SymbolIcon Mic24}" Click="OnMic" IsEnabled="{Binding CanUseMic}"
                               AutomationProperties.Name="Microphone" ToolTip="Click, ask out loud, click again to send" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- options and settings -->
        <Border Grid.Column="1" Width="360" Margin="0,4,24,20" Padding="0" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding IsPaneOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Options pane">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="18,14">
                    <TextBlock Text="ASK" Style="{StaticResource SectionCaption}" />
                    <ui:ToggleSwitch Content="Remember the conversation" IsChecked="{Binding MemoryOn, Mode=TwoWay}" Margin="0,0,0,4"
                                     AutomationProperties.Name="Remember"
                                     ToolTip="Keeps the last few questions and answers (text only) so follow-ups make sense" />

                    <TextBlock Text="EXTRAS" Style="{StaticResource SectionCaption}" />
                    <ui:ToggleSwitch Content="Speak answers" IsChecked="{Binding SpeakOn, Mode=TwoWay}" IsEnabled="{Binding SpeakAvailable}" Margin="0,0,0,4"
                                     AutomationProperties.Name="Speak" ToolTip="Read the summary of each answer aloud with the Windows voice" />
                    <ui:ToggleSwitch Content="Search the web" IsChecked="{Binding SearchOn, Mode=TwoWay}" IsEnabled="{Binding CanInput}" Margin="0,0,0,4"
                                     AutomationProperties.Name="Search web"
                                     ToolTip="Off by default. On: your typed question is sent as a search to Stack Overflow and Wikipedia (free, no account) and the top results are quoted to the model." />
                    <ui:ToggleSwitch Content="Smart query" IsChecked="{Binding SmartOn, Mode=TwoWay}" IsEnabled="{Binding SmartEnabled}" Margin="0,0,0,4"
                                     AutomationProperties.Name="Smart query"
                                     ToolTip="Let the model write the search: your question is first rewritten into keywords. If the cloud engine answers it may run its own Google searches from the whole question, including the screen and your voice." />

                    <TextBlock Text="AUTOMATION" Style="{StaticResource SectionCaption}" />
                    <ui:ToggleSwitch Content="Watch my screen" IsChecked="{Binding WatchOn, Mode=TwoWay}" Margin="0,0,0,2" AutomationProperties.Name="Watch screen"
                                     ToolTip="Off whenever the app starts. On: every few seconds, if the screen changed, the model on THIS PC checks it for an error and tells you once. Needs a local engine. Nothing leaves this PC and nothing is saved." />
                    <StackPanel Margin="0,0,0,6" Visibility="{Binding HasWatch, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding WatchText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <ui:Button Content="{Binding PauseText}" Click="OnPauseWatch" AutomationProperties.Name="{Binding PauseText}"
                                   ToolTip="Pause or resume watching (also in the tray menu)" />
                    </StackPanel>
                    <ui:ToggleSwitch Content="Allow running commands" IsChecked="{Binding ActionsOn, Mode=TwoWay}" Margin="0,0,0,4"
                                     AutomationProperties.Name="Allow running commands"
                                     ToolTip="Off by default. On: answers with a terminal command get a Run... button. It opens a dialog that shows the exact command and needs you to type RUN every time. Nothing ever runs by itself." />

                    <TextBlock Text="SETTINGS" Style="{StaticResource SectionCaption}" />
                    <TextBlock Text="Active endpoint" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding ActiveEndpoint, Mode=OneWay}" FontSize="12" Margin="0,0,0,8"
                             AutomationProperties.Name="Active endpoint address" />
                    <TextBlock Text="Override URL (empty = use the gist)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding OverrideUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://name.trycloudflare.com" Margin="0,2,0,8"
                                AutomationProperties.Name="Override URL" />
                    <TextBlock Text="Local node" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding LocalUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="http://127.0.0.1:8000" Margin="0,2,0,8"
                                AutomationProperties.Name="Local node URL" />
                    <TextBlock Text="This PC" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Capability, Mode=OneWay}" FontSize="12" Margin="0,0,0,8" AutomationProperties.Name="This PC details" />
                    <TextBlock Text="Hotkeys" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Hotkeys, Mode=OneWay}" FontSize="12" Margin="0,0,0,10" AutomationProperties.Name="Hotkeys list" />
                    <WrapPanel Margin="0,0,0,6">
                        <ui:Button Content="Apply" Click="OnApplySettings" Margin="0,0,8,6" AutomationProperties.Name="Apply settings" />
                        <ui:Button Content="Test connection" Click="OnTestConnection" Margin="0,0,8,6" AutomationProperties.Name="Test connection" />
                        <ui:Button Content="Open logs" Click="OnOpenLogs" Margin="0,0,8,6" AutomationProperties.Name="Open logs" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SettingsResult}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding SettingsResult, Converter={StaticResource NonEmptyToVisibility}}" />

                    <TextBlock Text="EVENTS" Style="{StaticResource SectionCaption}" />
                    <ListBox ItemsSource="{Binding Log}" MaxHeight="160" BorderThickness="0" Background="Transparent" FontSize="11"
                             AutomationProperties.Name="Events" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>

        <!-- the "Run command" approval: a card inside this window (which is hidden from screen capture), no default button -->
        <Grid x:Name="RunOverlay" Grid.RowSpan="2" Background="#B0000000"
              Visibility="{Binding HasRunApproval, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Run command dialog">
            <Border MaxWidth="760" Margin="28" VerticalAlignment="Center" Padding="24,20" CornerRadius="12" BorderThickness="1"
                    DataContext="{Binding RunApproval}"
                    Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760" Focusable="False">
                    <StackPanel>
                        <ui:TextBlock Text="Run this command?" FontTypography="Subtitle" Margin="0,0,0,10" />
                        <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </Border>
                        <TextBlock Text="{Binding ShellName, StringFormat='Shell: {0}'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Command, Mode=OneWay}" FontFamily="{StaticResource CodeFont}" FontSize="13"
                                 MinHeight="80" MaxHeight="200" Padding="10" TextWrapping="Wrap" AutomationProperties.Name="Command"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="{Binding VerdictText}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerdictIsRefusal}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Working folder" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Cwd, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,2,8,0"
                                            AutomationProperties.Name="Working folder" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Browse..." Click="OnRunBrowse" IsEnabled="{Binding CanEdit}" VerticalAlignment="Bottom" Margin="0,0,8,0"
                                       AutomationProperties.Name="Browse folder" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stop after (s)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:NumberBox Value="{Binding TimeoutSeconds, Mode=TwoWay}" Minimum="{Binding MinTimeout}" Maximum="{Binding MaxTimeout}"
                                              SmallChange="5" LargeChange="30" MaxDecimalPlaces="0" Width="120" Margin="0,2,0,0" IsEnabled="{Binding CanEdit}"
                                              AutomationProperties.Name="Timeout seconds" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ConfirmWord, StringFormat='To allow this, type {0}:'}" Margin="0,14,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBox x:Name="ConfirmBox" Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" IsEnabled="{Binding CanEdit}"
                                    PlaceholderText="type RUN" KeyDown="OnConfirmKeyDown" AutomationProperties.Name="Confirm text" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button Content="Run command" Appearance="Primary" Click="OnRunExecute" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"
                                       AutomationProperties.Name="Run command" ToolTip="Runs exactly the command shown above, once" />
                            <ui:Button Content="{Binding CloseText}" Click="OnRunCancel" AutomationProperties.Name="Cancel"
                                       ToolTip="Close without running (Esc does the same)" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding Status, Converter={StaticResource NonEmptyToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Output, Mode=OneWay}" FontFamily="{StaticResource CodeFont}" FontSize="12"
                                 MinHeight="100" MaxHeight="260" Padding="10" Margin="0,10,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}" AutomationProperties.Name="Output"
                                 Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- in-window dialogs (the "allow running commands" question) -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>

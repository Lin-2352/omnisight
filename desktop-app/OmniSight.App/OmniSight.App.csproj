<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\omnisight.ico</ApplicationIcon>
    <AssemblyTitle>OmniSight</AssemblyTitle>
    <Product>OmniSight</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\omnisight.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniSight.Core\OmniSight.Core.csproj" />
  </ItemGroup>

</Project>
